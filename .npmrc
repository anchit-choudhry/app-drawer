# Supply-chain hardening for every npm command run in this repository. See CLAUDE.md
# ("Security & Maintenance") for the reasoning and how to override either setting.

# Never run dependency lifecycle scripts (preinstall, install, postinstall). A compromised
# package can otherwise execute code on install. Explicit commands such as `npm test` and
# `npm run <script>` still run their own scripts.
ignore-scripts=true

# Fail the install instead of warning when Node or npm is outside the `engines` range.
engine-strict=true

# Only resolve versions published at least this many days ago, so a freshly compromised
# release cannot be pulled in by a new install or update. Versions already in
# package-lock.json are unaffected. To adopt a newer release sooner, lower this value
# for that one command, e.g. `npm update express --min-release-age=0`.
min-release-age=7
